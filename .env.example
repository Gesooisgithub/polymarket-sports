# Polymarket Trading Credentials
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file!

# Your MetaMask wallet private key (starts with 0x)
# Export from MetaMask: Account Details > Export Private Key
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here

# The wallet is NOT configurable: the bot always uses the Deposit Wallet
# derived from the private key above, the only one the CLOB accepts for
# programmatic orders. An EOA would be rejected with "maker address not
# allowed, please use the deposit wallet flow". At startup the bot prints the
# address it resolved: that is where the funds have to be.

# The L2 API credentials are not set here: the bot always derives them from the
# private key with create_or_derive_api_key().

# Log level (optional). Defaults to INFO; use DEBUG for troubleshooting.
# POLYMARKET_LOG_LEVEL=DEBUG

# HTTP proxy for the bot's own traffic (optional)
# Format: http://username:password@host:port
# Tested with IPRoyal ISP proxies (Ireland exit IP).
# IMPORTANT: disable any system-wide VPN (Bitdefender, etc.) when using this,
# to avoid double-tunneling and added latency.
# Leave commented (or unset) to use direct connection.
# IPROYAL_PROXY=http://user:pass@host:port
